# Copy this file to .env.local and set your Hugging Face token.
# Next.js does NOT load .env.example automatically — only .env.local is used at runtime.
#
# Required for:
# - Whisper speech-to-text (/api/transcribe)
# - Live question translation for German and other languages (/api/translate)
#
# HF_TOKEN=hf_your_token_here
# WHISPER_MODEL=openai/whisper-large-v3
