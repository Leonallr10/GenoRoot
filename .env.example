# Whisper (Hugging Face Inference API)
HF_TOKEN=hf_your_token_here
WHISPER_MODEL=openai/whisper-large-v3-turbo
# Comma-separated fallbacks if the primary HF model is unavailable:
# WHISPER_FALLBACK_MODELS=distil-whisper/distil-large-v3,openai/whisper-medium
# Optional dedicated inference endpoint:
# WHISPER_ENDPOINT=https://your-endpoint.endpoints.huggingface.cloud
# Prefer HF over Groq for STT: WHISPER_PROVIDER=huggingface

# Groq clinical report (openai/gpt-oss-20b)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Groq Whisper STT (uses selected intake language for accurate script)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
